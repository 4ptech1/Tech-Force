# Tech Force Consulting Engineers — Hostinger (LiteSpeed/Apache) configuration
# Tip: turn on "Force HTTPS" in hPanel → Security → SSL instead of redirecting here.

Options -Indexes
DirectoryIndex index.html

AddType image/webp .webp
AddType font/woff2 .woff2

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Hide repository metadata and docs that Git auto-deploy copies into public_html
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^(README\.md|LICENSE)$ - [F,L]

  # Send the bare domain to www (matches the canonical URLs in the pages)
  RewriteCond %{HTTP_HOST} ^techforceconsulting\.com$ [NC]
  RewriteRule ^(.*)$ https://www.techforceconsulting.com/$1 [R=301,L]
</IfModule>

# ---- Security headers ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ---- Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

# ---- Browser caching ----
# CSS/JS are linked with ?v=N — bump N after editing them so visitors get the new file.
# Images keep their filenames when swapped, so they are cached for a week only.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
